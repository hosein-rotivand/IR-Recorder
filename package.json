{
  "name": "ir-recorder",
  "productName": "IR Recorder",
  "version": "1.1.0",
  "description": "Personal screen recorder with Reels follow-cam, YouTube, browser and full screen modes.",
  "main": "src/main/main.js",
  "author": "Kasbomal <kasbomal.ir>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ir.kasbomal.irrecorder",
    "productName": "IR Recorder",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/uiohook-napi/prebuilds/{darwin-*,linux-*,win32-arm64}/**",
      "!node_modules/uiohook-napi/{src,libuiohook}/**",
      "!node_modules/ffmpeg-static/{*.README,*.LICENSE,README.md,example.js}",
      "!node_modules/ffmpeg-static/ffmpeg"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "IR Recorder",
      "artifactName": "IR-Recorder-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "IR-Recorder-Portable-${version}.exe"
    },
    "publish": null,
    "electronLanguages": [
      "en-US",
      "fa"
    ],
    "compression": "maximum"
  }
}
